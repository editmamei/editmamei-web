/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# The adapter appends /_app/* (no-cache) and then /_app/immutable/* (a year, immutable). An /_app/immutable/* block
# here would have the adapter merge its rules into this one instead, setting Cache-Control on the hashed files twice.
