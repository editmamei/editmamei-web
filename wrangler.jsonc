{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "editmamei-web",
	"compatibility_date": "2026-10-06",
	// Assets-only Worker: no script, every request is served from build/.
	"assets": {
		"directory": "./build",
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash"
	},
	// No public workers.dev URL. Preview URLs (the `staging` alias uploaded by
	// staging.yml) stay on, behind Cloudflare Access.
	"workers_dev": false,
	"preview_urls": true
}
