{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "editmamei-web",
	"compatibility_date": "2026-10-06",
	// worker/index.js wraps SvelteKit's Worker (@sveltejs/adapter-cloudflare, configured by wrangler.kit.jsonc)
	// to show prices in the visitor's currency (src/lib/pricing/local-prices.js). It runs first for every
	// request but the build's hashed files under /_app/, which are served without running it. SvelteKit's
	// Worker serves each prerendered page and asset from the build, and renders the gallery's two routes on
	// request and the 404 page.
	"main": "worker/index.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
		"html_handling": "auto-trailing-slash",
		"run_worker_first": ["/*", "!/_app/*"]
	},
	// No public workers.dev URL. Preview URLs (the `staging` alias uploaded by
	// staging.yml) stay on, behind Cloudflare Access.
	"workers_dev": false,
	// Workers Logs and traces, in the Worker's Observability tab. Every request that runs the script is
	// recorded: every page and asset but the hashed files under /_app/ (run_worker_first above).
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true },
		"traces": { "enabled": true, "head_sampling_rate": 1 }
	},
	"preview_urls": true,
	// editmamei.com is served through a route over its existing proxied DNS
	// record (GitHub Pages behind it), so no DNS change is needed. `wrangler
	// deploy` (deploy.yml) creates the route; staging's `versions upload` never
	// applies routes. www.editmamei.com is left to Pages' own redirect.
	// Rollback: delete the route (traffic falls back to Pages at once) AND
	// remove this entry on main before the next main push, or the next deploy
	// recreates it. Pages then serves its last pre-cutover build, so its site
	// and custom domain must stay enabled until the fallback window closes.
	"routes": [{ "pattern": "editmamei.com/*", "zone_name": "editmamei.com" }]
}
