{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "editmamei-web",
	"compatibility_date": "2026-10-06",
	// Assets-only Worker: no script, every request is served from build/.
	"assets": {
		"directory": "./build",
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash"
	},
	// No public workers.dev URL. Preview URLs (the `staging` alias uploaded by
	// staging.yml) stay on, behind Cloudflare Access.
	"workers_dev": false,
	"preview_urls": true,
	// editmamei.com is served through a route over its existing proxied DNS
	// record (GitHub Pages behind it), so no DNS change is needed and deleting
	// the route hands the site back to Pages at once. `wrangler deploy`
	// (deploy.yml) creates it; staging's `versions upload` never applies routes.
	// www.editmamei.com is left to Pages' own redirect to the apex.
	"routes": [{ "pattern": "editmamei.com/*", "zone_name": "editmamei.com" }]
}
