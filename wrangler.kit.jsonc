// Read only by @sveltejs/adapter-cloudflare (its options in vite.config.ts), which writes SvelteKit's Worker to `main`
// and the site's files to `assets.directory`, and which also reads it for the local platform under `vite dev`. Nothing
// deploys from this file: wrangler.jsonc does, with worker/index.js as its main, which wraps the Worker written here.
// Keep name, compatibility_date and assets equal to wrangler.jsonc's (tests/local-prices.test.mjs checks). A binding
// the deployed site needs goes in wrangler.jsonc, and here too if a route uses it under `vite dev`.
{
	"name": "editmamei-web",
	"compatibility_date": "2026-10-06",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	}
}
